{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Knowledge Base Root",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.entrypoint.factory:service_api",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Knowledge Base API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api.knowledge_base.factory:knowledge_api",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8002"
      ],
      "jinja": true,
      "justMyCode": false
    }
  ]
}
